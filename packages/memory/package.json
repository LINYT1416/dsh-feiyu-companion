{
  "name": "dsh-feiyu-memory",
  "version": "1.2.0",
  "type": "module",
  "description": "Layered memory, mood, and bounded personality state for DSH.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "tiers.js",
    "chronicle.js",
    "extract.js",
    "digest.js",
    "threads.js",
    "summary.js",
    "memory-engine.js",
    "memory-policy.js",
    "housekeeping.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@img/sharp-win32-x64": "^0.35.5",
    "@xenova/transformers": "^2.17.2",
    "sharp": "^0.35.5"
  }
}
